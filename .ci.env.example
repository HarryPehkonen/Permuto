# Local CI configuration (C++).
#
# Copy to .ci.env (which is gitignored) and edit what you need. This file is
# documentation: every knob below has a default in tools/ci.sh, so with no .ci.env at
# all the repo behaves exactly as described here.
#
#   cp .ci.env.example .ci.env

# Parallel build jobs for the build/asan/tsan/pristine stages.
CI_JOBS=4

# Build type for the normal, sanitizer and pristine builds.
CI_BUILD_TYPE=Debug

# Stages run when no stage names are given on the command line.
# What this repo can certify today. tree, format and tidy are excluded with reasons in
# the notes at the end of this file; both hooks run this list, and the fast tier is
# still "build tests".
# CI_DEFAULT_STAGES="tree format build tests version asan tsan tidy pristine"
CI_DEFAULT_STAGES="build tests version asan tsan pristine"

# 1 = a missing tool (clang-format, clang-tidy) FAILS the run instead of SKIPping it.
# Set to 1 on a machine that is supposed to have them, so a silently missing gate
# cannot pass unnoticed.
CI_STRICT_TOOLS=0

# 1 = keep the pristine-checkout temp directory after a run (its path is printed).
CI_KEEP_TMP=0

# Where per-stage output goes. Gitignored; on failure the tail is printed and the path
# is named. Every one of these paths must be in .gitignore: the tree stage fails when
# the gate's own footprint would show up as an untracked file.
CI_LOG_DIR=.ci-logs
# build-ci*, not build/: the old build/ tree is COMMITTED in this repo, so building
# in build/ rewrites tracked files and dirties the tree the gate is certifying.
CI_BUILD_DIR=build-ci
CI_ASAN_BUILD_DIR=build-ci-asan
CI_TSAN_BUILD_DIR=build-ci-tsan

# Relative to the temp checkout in the pristine stage. build/ cannot be used there:
# its committed CMakeCache.txt points at the real source dir, and CMake refuses to
# reuse a cache generated for a different source directory.
CI_PRISTINE_BUILD_DIR=ci-build

# The source set the format and tidy stages own (a space-separated list of git pathspecs).
CI_SOURCE_GLOBS="'*.cpp' '*.cc' '*.cxx' '*.hpp' '*.hh' '*.h'"

# Extra -D flags for every configure in this script (dependencies, options, presets).
# CI_CMAKE_FLAGS="-DMYPROJECT_BUILD_TOOLS=ON"

# The test runner, given to `eval` with $CI_BUILD_DIR and $CI_JOBS expanded at run time.
# ctest is the portable default; a project that does not register tests with add_test()
# points this at its own suite instead:
#   CI_TEST_CMD="./\$CI_BUILD_DIR/my_tests --quiet"
CI_TEST_CMD="ctest --test-dir \$CI_BUILD_DIR --output-on-failure -j \$CI_JOBS"

# Where the SECOND copy of the version number lives — the file the version stage
# compares against project(<name> VERSION x.y.z) in CMakeLists.txt. Two shapes are
# both fine:
#
#   generated by CMake (recommended):
#     # CMakeLists.txt
#     project(myapp VERSION 0.1.0 LANGUAGES CXX)
#     configure_file(cmake/version.hpp.in ${CMAKE_BINARY_DIR}/generated/version.hpp @ONLY)
#     # cmake/version.hpp.in
#     #pragma once
#     #define APP_VERSION "@PROJECT_VERSION@"
#
#   tracked by hand:  CI_VERSION_HEADER=include/myapp/version.hpp
CI_VERSION_HEADER="$CI_BUILD_DIR/generated/version.hpp"

# Binaries that must answer `--version` with the same number (a glob, expanded by the
# shell). Unset means the binaries are not asked — every project names them differently.
CI_VERSION_BINARIES="$CI_BUILD_DIR/permuto"

# clang-tidy baseline — OPTIONAL. With no file, the tidy stage requires ZERO findings.
# Create one only to tolerate findings you inherited:
#   tools/ci.sh tidy && grep -E "warning:|error:" .ci-logs/tidy.log | sort -u > .ci/tidy-baseline.txt
CI_TIDY_BASELINE=.ci/tidy-baseline.txt

# ---------------------------------------------------------------------------
# PERMUTO OVERRIDES — the stages that are NOT wired, and why
# ---------------------------------------------------------------------------
#
# tree   — FAILS AT HEAD, and cannot be made to pass without changing the repo's
#          contents. 130 of the 163 committed files ARE the old build/ tree. If build/
#          is added to .gitignore, the stage fails with "tracked files matched by
#          .gitignore (stale rules)"; if it is not, it fails with "NOT ignored: build".
#          The fix is `git rm -r --cached build/` + commit — a repo-owner decision, so
#          the stage is out of the list and reports the truth on demand:
#              tools/ci.sh tree
#
# format — NOT ENFORCEABLE YET. There is no .clang-format in this repo (CODING_STANDARDS.md
#          refers to "the repo's .clang-format", which does not exist), and under the
#          closest matching configuration all 23 sources drift — 510 violations, with
#          cli/main.cpp alone needing 83 of its 157 lines rewritten. Format-on-touch on a
#          repo in that state means every future edit to any file starts with a 50%
#          reformat of it. The honest sequence is a one-time whole-tree format commit
#          FIRST (which buries git blame, so it is a decision), then wire this stage.
#          Until then:  tools/ci.sh format
#
# tidy   — NOT CONFIGURED. There is no .clang-tidy, and this repo's CODING_STANDARDS.md
#          scopes it to repos where it is configured ("no NEW findings vs baseline
#          (where tidy is configured)"). Running it with no config uses clang-tidy's own
#          defaults, which are not this project's standard.
#
# What IS wired, on every push: build (-Werror) -> tests -> version (identity) -> asan
# (ASan+UBSan) -> tsan -> pristine (the committed tree builds and tests on its own).
#
# Known pre-existing failures left unfixed, with the exact stage and message:
#   1. tree     — "tracked files matched by .gitignore" / "NOT ignored: build" (130 files)
#   2. format   — drift in 23/23 sources; no .clang-format exists
#   3. nothing else: build (-Werror), the 58 tests, the version identity, ASan+UBSan,
#      ThreadSanitizer and the pristine-checkout build all pass on this commit.
#
# Checked and NOT a finding, recorded so the next reader does not re-open it:
# write_basic_package_version_file(VERSION ${PACKAGE_VERSION}) at the bottom of
# CMakeLists.txt reads as a bug (PACKAGE_VERSION is never set), but CMake's module falls
# back to PROJECT_VERSION when the argument is empty, and build-ci/PermutoConfigVersion.cmake
# does contain set(PACKAGE_VERSION "1.0.0"). Worth knowing: that generated file is a THIRD
# copy of the version number, and nothing in this gate compares it.
