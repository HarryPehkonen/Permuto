#!/usr/bin/env bash
#
# pre-push: the FULL tier — the gate, on the tree you are about to publish.
#
# from AI-DEV-STARTER (plunk-in kit) — if you edit this file, say why in INCIDENTS.md.
# Install as .githooks/pre-push and arm it once per clone:
#
#     git config core.hooksPath .githooks
#
# For C++ it also requires a clean worktree and proves the COMMITTED tree is complete
# by building and testing a pristine checkout of HEAD. For deno/python the same script
# is already the whole gate and already includes its own clean-checkout story.
#
# Deliberate bypass when you need one:  git push --no-verify
#
set -uo pipefail

root=$(git rev-parse --show-toplevel) || exit 1

if [ -x "$root/tools/ci.sh" ]; then
    # PERMUTO: the stage list is this repo's own (see the adaptation notes at the top of
    # tools/ci.sh). tree, format and tidy are NOT in it: tree cannot pass while the old
    # build/ tree is committed, format has no .clang-format to enforce yet, and tidy has
    # no .clang-tidy. What runs here is what this repo can actually certify.
    #
    # --require-clean is passed through for the day `tree` comes back, but it does
    # nothing without that stage, and "do not publish an uncommitted tree" is the one
    # thing this hook must not lose — so the check lives here instead.
    if [ -n "$(git -C "$root" status --porcelain --untracked-files=no)" ]; then
        printf 'pre-push: uncommitted changes to tracked files — commit or stash them first:\n' >&2
        git -C "$root" status --porcelain --untracked-files=no >&2
        printf '\nGATE FAILED\n' >&2
        exit 1
    fi
    exec "$root/tools/ci.sh" \
        --require-clean \
        build tests version asan tsan pristine
fi

if [ -x "$root/scripts/gate.sh" ]; then
    exec "$root/scripts/gate.sh"
fi

printf 'pre-push: no gate found. Expected %s/tools/ci.sh (C++) or %s/scripts/gate.sh (deno/python).\n' \
    "$root" "$root" >&2
exit 1
