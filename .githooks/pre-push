#!/usr/bin/env bash
#
# pre-push: the FULL tier — the gate, on the tree you are about to publish.
#
# from AI-DEV-STARTER (plunk-in kit) — if you edit this file, say why in INCIDENTS.md.
# Install as .githooks/pre-push and arm it once per clone:
#
#     git config core.hooksPath .githooks
#
# For C++ it also requires a clean worktree and proves the COMMITTED tree is complete
# by building and testing a pristine checkout of HEAD. For deno/python the same script
# is already the whole gate and already includes its own clean-checkout story.
#
# Deliberate bypass when you need one:  git push --no-verify
#
set -uo pipefail

root=$(git rev-parse --show-toplevel) || exit 1

if [ -x "$root/tools/ci.sh" ]; then
    # PERMUTO: this repo's own stage list (see the adaptation notes at the top of
    # tools/ci.sh). `tidy` is not in it — there is no .clang-tidy here, and this repo's
    # CODING_STANDARDS.md scopes tidy to repos where it is configured.
    #
    # --require-clean is the "never publish an uncommitted tree" rule. Until 2026-09-20
    # the check had to live in this hook, because the `tree` stage it belongs to could
    # not pass while the old build/ tree was committed; with build/ untracked, `tree` is
    # wired in and the rule is back where a human can also run it: `tools/ci.sh tree`.
    exec "$root/tools/ci.sh" \
        --require-clean \
        tree format build tests version asan tsan pristine
fi

if [ -x "$root/scripts/gate.sh" ]; then
    exec "$root/scripts/gate.sh"
fi

printf 'pre-push: no gate found. Expected %s/tools/ci.sh (C++) or %s/scripts/gate.sh (deno/python).\n' \
    "$root" "$root" >&2
exit 1
